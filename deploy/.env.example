# 复制为 deploy/.env 后逐项填写。不要提交 .env,不要复用示例里的任何值。

# 对外域名(DNS A/AAAA 记录需已指向本机),与证书联系邮箱。
TYPOZA_DOMAIN=sync.example.com
ACME_EMAIL=admin@example.com

# 数据库口令。生成:openssl rand -hex 24(十六进制,放进连接串无需转义)
POSTGRES_PASSWORD=

# MinIO 管理账号与口令。口令生成:openssl rand -hex 24
MINIO_ROOT_USER=typoza
MINIO_ROOT_PASSWORD=

# 访问令牌签名私钥(Ed25519 的 32 字节种子)。生成:openssl rand -base64 32
# 多实例必须使用同一把;更换后所有在线设备需重新登录。
TYPOZA_JWT_PRIVATE_KEY=

# 服务端数据密钥(加密 TOTP 密钥)。生成:openssl rand -base64 32
# 丢失后已开启的二次验证无法校验,只能走恢复流程关闭;务必与数据库备份分开保管。
TYPOZA_DATA_KEY=

# 防邮箱探测密钥(prelogin 假参数)。生成:openssl rand -base64 32
# 更换后未注册邮箱的假盐会变化,不影响已注册账号。
TYPOZA_ENUM_SECRET=

# 注册开关:open | closed(自用时注册完自己的账号后可改为 closed)
TYPOZA_REGISTRATION=open

# 每账号存储配额(字节),默认 10 GiB
TYPOZA_QUOTA_BYTES=10737418240

# 日志级别:debug | info | warn | error
TYPOZA_LOG_LEVEL=info
